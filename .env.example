# Required
BOT_TOKEN=
ADMIN_IDS=

# Production database (Railway/PostgreSQL recommended)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# Optional Redis (recommended in production for distributed locks/FSM)
REDIS_URL=

TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
DEFAULT_OFFER_EXPIRY_HOURS=24

# Telegram Stars
ENABLE_TELEGRAM_STARS=true
STARS_PAYMENT_SECRET=CHANGE_ME_TO_A_RANDOM_32_PLUS_CHARACTER_SECRET

# PostgreSQL connection pool (Railway: keep modest for small plans)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Production uses Alembic migrations; enable only for controlled legacy/local upgrades
AUTO_SCHEMA_UPGRADE=false
